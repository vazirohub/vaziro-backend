PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
DATABASE_URL="file:./dev.db"

# JWT Configuration
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_EXPIRES_IN=30d
JWT_REFRESH_EXPIRES_IN=90d

# API Setu / MeriPehchaan (DigiLocker)
APISETU_CLIENT_ID=your_apisetu_client_id
APISETU_CLIENT_SECRET=your_apisetu_client_secret
APISETU_REDIRECT_URI=https://vaziro.in/verify/callback
APISETU_AUTH_URL=https://apisetu.gov.in/auth/realms/apisetu/protocol/openid-connect/auth
APISETU_TOKEN_URL=https://apisetu.gov.in/auth/realms/apisetu/protocol/openid-connect/token
APISETU_USERINFO_URL=https://apisetu.gov.in/auth/realms/apisetu/protocol/openid-connect/userinfo
VERIFICATION_PROVIDER=APISETU

# Razorpay Configuration
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
RAZORPAY_ENVIRONMENT=test

# MSG91 Configuration
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_SENDER_ID=VAZIRO
MSG91_WIDGET_ID=your_msg91_widget_id
MSG91_TOKEN_AUTH=your_msg91_token_auth
SMS_PROVIDER=MSG91

# Resend Email Configuration
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL="Vaziro <noreply@vaziro.in>"
RESEND_SUPPORT_EMAIL=support@vaziro.in
